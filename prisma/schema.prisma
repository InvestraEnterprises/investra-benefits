generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Partner {
  id          String   @id @default(uuid())
  name        String
  description String?
  logoUrl     String?
  status      String   @default("ACTIVE")
  offers      Offer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          String   @id @default(uuid())
  name        String
  icon        String?
  status      String   @default("ACTIVE")
  offers      Offer[]
  createdAt   DateTime @default(now())
}

model Offer {
  id            String   @id @default(uuid())
  slug          String   @unique
  partnerId     String
  categoryId    String
  title         String
  description   String?
  imageUrl      String?
  regularPrice  String?
  guestPrice    String?
  discount      String?
  offerType     String   
  affiliateUrl  String?
  voucherCode   String?
  status        String   @default("ACTIVE")
  
  partner       Partner  @relation(fields: [partnerId], references: [id])
  category      Category @relation(fields: [categoryId], references: [id])
  events        TrackingEvent[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TrackingEvent {
  id          String   @id @default(uuid())
  eventType   String   
  offerId     String?
  partnerId   String?
  source      String?  
  createdAt   DateTime @default(now())

  offer       Offer?   @relation(fields: [offerId], references: [id])
}
